# Extra kernel options for Android 16 (Lineage 23.2) on 4.19: BPF/net programs, memory pressure (PSI), ART UFFD GC.
# Mirrors what Lineage's maintained SDM660 4.19 kernel enables on top of the user's vendor defconfig.
CONFIG_PSI=y
CONFIG_USERFAULTFD=y
CONFIG_SCHEDSTATS=y
CONFIG_XDP_SOCKETS=y
CONFIG_NET_SCH_INGRESS=y
CONFIG_NET_ACT_BPF=y
CONFIG_NET_CLS_MATCHALL=y
CONFIG_NET_ACT_POLICE=y
CONFIG_NET_SCH_HTB=y
CONFIG_NET_SCH_PRIO=y
CONFIG_NET_SCH_MULTIQ=y
CONFIG_NET_SCH_NETEM=y
CONFIG_NET_SCH_TBF=y
CONFIG_BFQ_GROUP_IOSCHED=y
# NOTE: CONFIG_MEMCG intentionally NOT enabled: this kernel replaces shrinker_rwsem with fine-grained locks (mm/vmscan.c), which breaks the memcg shrinker code.

# SELinux denials are only logged (dmesg/logcat avc:) when audit is built in
CONFIG_AUDIT=y

# Replacement-panel quirk (user's device only): keep NVT touch out of deep sleep so it responds instantly after screen-on
CONFIG_TOUCHSCREEN_NVT_NO_DEEPSLEEP=y
